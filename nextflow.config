    homePage        = 'https://github.com/nf-core/diseasemodulediscovery'
    description     = """A pipeline for network-based disease module identification"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.0'
    version         = '1.0.0'
    doi             = '10.1093/bioinformatics/btag223'
